// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                       @id @default(uuid())
  email                  String                       @unique
  name                   String
  password               String
  referralCode           String?                      @unique
  // Who invited this user (their referralCode at sign-up), and when the one-time
  // referee discount on their first purchase was spent.
  referredById           String?
  referredBy             User?                        @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals              User[]                       @relation("Referrals")
  referralDiscountUsedAt DateTime?
  isEmailVerified        Boolean                      @default(false)
  role                   UserRole                     @default(USER)
  phone                  String?
  country                String?
  fieldOfExpertise       String?
  teachingExperience     String?
  availability           AvailabilityType?
  avatarUrl              String?
  bio                    String?
  credits                Int                          @default(0)
  isSuspended            Boolean                      @default(false)
  mustChangePassword     Boolean                      @default(false)
  verifications          Verification[]
  enrollments            Enrollment[]
  payments               Payment[]
  creditTransactions     CreditTransaction[]
  lessonProgress         LessonProgress[]
  liveSessions           LiveSession[]                @relation("CreatorSessions")
  sessionAttendance      SessionAttendance[]
  notifications          Notification[]
  createdCourses         Course[]                     @relation("CreatedCourses")
  refreshTokens          RefreshToken[]
  discountRedemptions    DiscountRedemption[]
  discountInvites        DiscountCampaignInvite[]
  onboarding             StudentOnboarding?
  badges                 UserBadge[]
  reviews                Review[]
  certificates           Certificate[]
  lessonNotes            LessonNote[]
  lessonDiscussions      LessonDiscussion[]
  assignmentSubmissions  AssignmentSubmission[]
  projectSubmissions     ProjectMilestoneSubmission[]
  notificationPreference NotificationPreference?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@index([referredById])
}

// Email opt-outs. No row means every email is on.
model NotificationPreference {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAssignmentGraded Boolean  @default(true)
  emailLiveSessions     Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Verification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationType
  token     String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id                    String       @id @default(uuid())
  name                  String
  shortDescription      String
  fullDescription       String
  heroImageName         String?
  duration              Int
  durationType          DurationType
  targetLevel           TargetLevel
  maxCohortSize         Int
  tuitionFee            Int
  costCredit            Int?
  certificationOffered  Boolean?
  capstoneRequired      Boolean?
  careerSupportIncluded Boolean?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  creatorId String?
  creator   User?   @relation("CreatedCourses", fields: [creatorId], references: [id], onDelete: SetNull)

  modules            Modules[]
  enrollments        Enrollment[]
  payments           Payment[]
  creditTransactions CreditTransaction[]
  liveSessions       LiveSession[]
  reviews            Review[]
  certificates       Certificate[]
  projects           CourseProject[]

  // Defaults to ACTIVE so pre-existing courses stay live; new courses are
  // created as DRAFT in CourseService.createCourse.
  status               CourseStatus @default(ACTIVE)
  rejectionReason      String?
  /// Optional screenshots an admin attached when requesting changes; cleared on approve/resubmit.
  rejectionAttachments String[]     @default([])

  /// Each program is one cohort: it runs from startsAt to endsAt. New seats (capped by
  /// maxCohortSize) are sold until enrollmentClosesAt, then again with no cap once it ends, as a rewatch.
  startsAt           DateTime?
  enrollmentClosesAt DateTime?
  endsAt             DateTime?

  @@index([id])
  @@index([categoryId])
}

model Modules {
  id               String @id @default(uuid())
  title            String
  description      String
  lessonsCount     Int
  assignmentsCount Int?
  order            Int    @default(0)

  courseId           String
  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments        Assignments[]
  enrolledModules    EnrolledModule[]
  payments           Payment[]
  creditTransactions CreditTransaction[]
  lessons            Lesson[]
  liveSessions       LiveSession[]

  @@index([courseId])
}

model Lesson {
  id           String            @id @default(uuid())
  title        String
  description  String?
  contentType  LessonContentType
  videoUrl     String?
  content      String?
  // Only set for code lessons; drives the editor's highlighting and formatter.
  codeLanguage String?
  duration     Int?
  /// Real video length reported by the first learner's player; drives the 80%-watched rule.
  videoSeconds Int?
  order        Int               @default(0)

  videoProcessingStatus LessonVideoStatus?
  videoProcessingError  String?

  moduleId    String
  module      Modules            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  notes       LessonNote[]
  discussions LessonDiscussion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  /// Seconds actually spent watching/reading, as credited by the engagement heartbeat.
  engagedSeconds  Int       @default(0)
  lastHeartbeatAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model LiveSession {
  id             String            @id @default(uuid())
  title          String
  type           SessionType
  /// Replay link the host adds after the session; shown to the cohort's learners, including rewatch buyers.
  recordingUrl   String?
  scheduledAt    DateTime
  durationMins   Int
  status         LiveSessionStatus @default(SCHEDULED)
  /// Set when the 30-minute reminder goes out; claimed atomically so it's sent once across API instances.
  reminderSentAt DateTime?
  /// When the host opened the waiting room, went live, and ended the session.
  openedAt       DateTime?
  startedAt      DateTime?
  endedAt        DateTime?

  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId  String?
  module    Modules? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  creatorId String
  creator   User     @relation("CreatorSessions", fields: [creatorId], references: [id], onDelete: Cascade)

  attendance SessionAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([creatorId])
}

model SessionAttendance {
  id        String           @id @default(uuid())
  sessionId String
  session   LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime?
  leftAt    DateTime?
  status    AttendanceStatus @default(REGISTERED)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String
  /// In-app path the notification opens (e.g. /programs/:id/lessons/:lessonId).
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Assignments {
  id          String    @id @default(uuid())
  title       String?
  description String?   @db.Text
  maxScore    Int       @default(100)
  /// [{ id, question, responseType, description?, options? }]
  questions   Json      @default("[]")
  /// Null while the creator is still drafting; learners only see published ones.
  publishedAt DateTime?
  moduleId    String
  module      Modules   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([id, moduleId])
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
}

model AssignmentSubmission {
  id           String                     @id @default(uuid())
  assignmentId String
  assignment   Assignments                @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ questionId, text?, fileKey?, fileName? }]
  answers      Json
  notes        String?                    @db.Text
  status       AssignmentSubmissionStatus @default(SUBMITTED)
  score        Int?
  feedback     String?                    @db.Text
  submittedAt  DateTime                   @default(now())
  gradedAt     DateTime?
  updatedAt    DateTime                   @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId])
}

enum CourseProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// What learners hand in for each milestone: a recording upload, code (link or
/// ZIP), or a document (file or link).
enum ProjectSubmissionType {
  RECORDING
  CODE
  DOCUMENT
}

model CourseProject {
  id             String                @id @default(uuid())
  courseId       String
  course         Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  description    String                @db.Text
  /// Ordered milestone labels; learners submit them in order.
  milestones     String[]
  submissionType ProjectSubmissionType @default(CODE)
  status         CourseProjectStatus   @default(ACTIVE)

  submissions ProjectMilestoneSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model ProjectMilestoneSubmission {
  id             String        @id @default(uuid())
  projectId      String
  project        CourseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneIndex Int
  /// Set when the learner shared a link; otherwise fileUrl holds the upload.
  url            String?
  fileUrl        String?
  fileName       String?
  notes          String?       @db.Text
  submittedAt    DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([projectId, userId, milestoneIndex])
  @@index([userId])
}

model Enrollment {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  type   EnrollmentType   @default(FULL_COURSE)
  status EnrollmentStatus @default(PENDING)

  enrolledModules EnrolledModule[]
  payments        Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model EnrolledModule {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Modules    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([enrollmentId, moduleId])
  @@index([enrollmentId])
  @@index([moduleId])
}

model Payment {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       Modules?    @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  discountCampaignId     String?
  discountAmount         Int? // USD saved by a discount code on this payment
  referralDiscountAmount Int? // USD saved by the one-time referee discount

  amount    Int // Amount in USD (after any discount)
  credits   Int? // Amount in Credits (for top ups)
  reference String        @unique // Paystack transaction reference
  status    PaymentStatus @default(PENDING)
  type      PaymentType

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([reference])
}

// One review per student per course, only after they complete it (see
// ReviewService.upsertReview). userId+courseId unique so a resubmission
// edits their existing review instead of creating a duplicate.
model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CreditTransaction {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int // Positive for added credits (+), Negative for deducted credits (-)
  balanceAfter Int // User credit balance after transaction
  type         CreditTransactionType
  description  String?
  reference    String? // Paystack reference or internal transaction ID

  courseId String?
  course   Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  moduleId String?
  module   Modules? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([reference])
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  /// An admin has started reviewing; the creator can no longer edit until it is rejected.
  IN_REVIEW
  ACTIVE
  REJECTED
}

enum UserRole {
  USER
  INSTRUCTOR
  ADMIN
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  // One-time code handed to the frontend after an OAuth callback; exchanged
  // for a token pair so access/refresh tokens never appear in a URL.
  OAUTH_EXCHANGE
}

enum DurationType {
  weeks
  Months
}

enum TargetLevel {
  Foundation
  Intermediate
  Advanced
}

enum AvailabilityType {
  FULL_TIME
  PART_TIME
}

enum EnrollmentType {
  FULL_COURSE
  MODULAR
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum PaymentType {
  CREDIT_TOP_UP
  FULL_COURSE
  MODULE
}

enum CreditTransactionType {
  TOP_UP
  COURSE_PURCHASE
  MODULE_PURCHASE
  REFUND
}

enum LessonContentType {
  video
  note
  code
}

enum LessonVideoStatus {
  PENDING
  READY
  FAILED
}

enum SessionType {
  Lecture
  Workshop
  QandA
}

enum LiveSessionStatus {
  SCHEDULED
  /// Host opened the waiting room: learners can join, the class hasn't started.
  WAITING
  LIVE
  ENDED
  CANCELLED
}

enum AttendanceStatus {
  REGISTERED
  ATTENDED
  MISSED
}

enum DiscountAppliesTo {
  CREDIT_TOP_UP
  COURSE_PURCHASE
  ALL
}

enum DiscountTarget {
  CREDIT_TOP_UP
  COURSE_PURCHASE
}

model DiscountCampaign {
  id             String            @id @default(uuid())
  name           String
  code           String            @unique
  description    String?
  percentOff     Int
  appliesTo      DiscountAppliesTo @default(ALL)
  startsAt       DateTime
  endsAt         DateTime
  maxRedemptions Int?
  perUserLimit   Int               @default(1)
  isActive       Boolean           @default(true)
  createdById    String?
  // True restricts the code to `invitees`; false (the default) leaves it open to
  // anyone who has the code, same as before this field existed.
  isInviteOnly   Boolean           @default(false)

  redemptions DiscountRedemption[]
  invitees    DiscountCampaignInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
}

// One row per user allowed to redeem an invite-only campaign.
model DiscountCampaignInvite {
  id         String           @id @default(uuid())
  campaignId String
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
}

// One row per use of a campaign. Amounts are USD for CREDIT_TOP_UP and
// credits for COURSE_PURCHASE.
model DiscountRedemption {
  id             String           @id @default(uuid())
  campaignId     String
  campaign       DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  target         DiscountTarget
  originalAmount Int
  discountAmount Int
  finalAmount    Int
  reference      String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([userId])
  @@index([campaignId, userId])
}

enum AcademicBackgroundType {
  UPLOAD_ACADEMIC_RESULTS
  JOS_LEARNING_ASSESSMENT
}

enum EducationLevel {
  JUNIOR_SECONDARY_SCHOOL
  SENIOR_SECONDARY_SCHOOL
  POLYTECHNIC
  UNIVERSITY
  GRADUATE
  WORKING_PROFESSIONAL
  OTHER
}

enum OnboardingStep {
  INTERESTS
  EDUCATION
  EXPERIENCE
  BACKGROUND
  DONE
}

enum PracticalExperience {
  NEVER_BUILT_ANYTHING
  COMPLETED_PERSONAL_PROJECTS
  PARTICIPATED_IN_COMPETITIONS
  WORKED_PROFESSIONALLY
  UPLOAD_WORK
}

model StudentOnboarding {
  id                     String                  @id @default(uuid())
  userId                 String                  @unique
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests              String[]                @default([])
  otherInterest          String?
  educationLevel         EducationLevel?
  otherEducationLevel    String?
  institutionName        String?
  currentClassOrLevel    String?
  expectedGraduationYear String?
  practicalExperience    PracticalExperience?
  workPortfolioUrl       String?
  workAttachmentUrl      String?
  workSamples            Json?
  academicBackgroundType AcademicBackgroundType?
  academicResultsUrl     String?
  academicResultsType    String?
  academicDocuments      Json?
  assessmentScore        Int?
  assessmentTotal        Int?                    @default(16)
  assessmentAnswers      Json?
  assessmentCompleted    Boolean                 @default(false)
  currentStep            OnboardingStep          @default(INTERESTS)
  isCompleted            Boolean                 @default(false)
  completedAt            DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([userId])
}

model AssessmentQuestion {
  id        String   @id @default(uuid())
  subject   String
  prompt    String
  options   Json
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

enum BadgeTriggerType {
  COURSE_COMPLETION
  MODULE_COMPLETION
  COURSES_COMPLETED_MILESTONE
  COURSES_PURCHASED_MILESTONE
  MODULES_PURCHASED_MILESTONE
  CREDIT_PURCHASES_MILESTONE
  MANUAL
}

model Badge {
  id            String           @id @default(uuid())
  name          String
  description   String
  icon          String
  triggerType   BadgeTriggerType
  triggerConfig Json?
  order         Int              @default(0)
  isActive      Boolean          @default(true)
  earnedBy      UserBadge[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([isActive, order])
  @@index([triggerType])
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// Issued once a learner completes every lesson in a course. Recipient and course
// names are snapshotted so a certificate never changes after it is issued.
model Certificate {
  id            String   @id @default(uuid())
  serial        String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recipientName String
  courseName    String
  issuedAt      DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

model LessonNote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
}

// Threads are rows with no parent; replies point at their thread. Replies are
// one level deep only — replying to a reply attaches to the same thread.
model LessonDiscussion {
  id        String             @id @default(uuid())
  lessonId  String
  lesson    Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String             @db.Text
  parentId  String?
  parent    LessonDiscussion?  @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   LessonDiscussion[] @relation("DiscussionReplies")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([lessonId, createdAt])
  @@index([parentId])
}

/// Append-only record of security-relevant and administrative actions. No foreign
/// keys on purpose: entries must outlive the users and records they describe.
model AuditLog {
  id         String    @id @default(uuid())
  /// Null for anonymous events, e.g. a failed sign-in for an unknown email.
  actorId    String?
  actorRole  UserRole?
  /// Dotted verb such as "course.approve" or "auth.sign_in_failed" (see audit-actions.ts).
  action     String
  targetType String?
  targetId   String?
  /// Context such as a rejection reason or old/new values. Never secrets or passwords.
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
