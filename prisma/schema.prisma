// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  name               String
  password           String
  referralCode       String?           @unique
  isEmailVerified    Boolean           @default(false)
  role               UserRole          @default(USER)
  phone              String?
  country            String?
  fieldOfExpertise   String?
  teachingExperience String?
  availability       AvailabilityType?
  credits            Int               @default(0)
  verifications      Verification[]
  enrollments        Enrollment[]
  payments           Payment[]
  creditTransactions CreditTransaction[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Verification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationType
  token     String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  courses     Course[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Course {
  id                    String        @id @default(uuid())
  name                  String
  shortDescription      String
  fullDescription       String
  heroImageName         String?
  duration              Int
  durationType          DurationType
  targetLevel           TargetLevel
  maxCohortSize         Int
  tuitionFee            Int
  costCredit            Int?
  certificationOffered  Boolean?
  capstoneRequired      Boolean?
  careerSupportIncluded Boolean?

  categoryId            String?
  category              Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  modules               Modules[]
  enrollments           Enrollment[]
  payments              Payment[]
  creditTransactions    CreditTransaction[]
  
  @@index([id])
  @@index([categoryId])
}

model Modules {
  id               String           @id @default(uuid())
  title            String
  description      String
  lessonsCount     Int
  assignmentsCount Int?

  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments      Assignments[]
  enrolledModules  EnrolledModule[]
  payments         Payment[]
  creditTransactions CreditTransaction[]

  @@index([courseId])
}

model Assignments {
  id               String        @id @default(uuid())
  title            String?
  moduleId         String
  module           Modules       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([id, moduleId])
}

model Enrollment {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  type            EnrollmentType    @default(FULL_COURSE)
  status          EnrollmentStatus  @default(PENDING)

  enrolledModules EnrolledModule[]
  payments        Payment[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model EnrolledModule {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId     String
  module       Modules    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  unlockedAt   DateTime   @default(now())

  @@unique([enrollmentId, moduleId])
  @@index([enrollmentId])
  @@index([moduleId])
}

model Payment {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId     String?
  module       Modules?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  enrollmentId String?
  enrollment   Enrollment?   @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  amount       Int           // Amount in Naira
  credits      Int?          // Amount in Credits (for top ups)
  reference    String        @unique // Paystack transaction reference
  status       PaymentStatus @default(PENDING)
  type         PaymentType

  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([reference])
}

model CreditTransaction {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int                   // Positive for added credits (+), Negative for deducted credits (-)
  balanceAfter Int                   // User credit balance after transaction
  type         CreditTransactionType
  description  String?
  reference    String?               // Paystack reference or internal transaction ID

  courseId     String?
  course       Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  moduleId     String?
  module       Modules?              @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  createdAt    DateTime              @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([reference])
}

enum UserRole {
  USER
  INSTRUCTOR
  ADMIN
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DurationType {
  weeks
  Months
}

enum TargetLevel {
  Foundation
  Intermediate
  Advanced
}

enum AvailabilityType {
  FULL_TIME
  PART_TIME
}

enum EnrollmentType {
  FULL_COURSE
  MODULAR
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum PaymentType {
  CREDIT_TOP_UP
  FULL_COURSE
  MODULE
}

enum CreditTransactionType {
  TOP_UP
  COURSE_PURCHASE
  MODULE_PURCHASE
  REFUND
}