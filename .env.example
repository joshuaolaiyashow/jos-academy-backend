# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/jos_academy_db

# Backend HTTP port.
PORT=3000

# The FRONTEND's origin — used to build links emailed to users (email
# verification, password reset, creator-credential sign-in). NOT this API's
# own URL. Production: https://jos-academy.d2edm0lxslfxbn.amplifyapp.com
APP_URL=http://localhost:3000

# Access tokens (15m) and refresh tokens (30d) are signed with separate
# secrets so a leaked access-token secret can't be used to mint refresh
# tokens. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# JOS Workspace (Keycloak). Leave KEYCLOAK_ISSUER unset to accept only the local JWT on /workspace/admin.
KEYCLOAK_ISSUER=http://localhost:8180/realms/jos
KEYCLOAK_AUDIENCE=academy-api
# KEYCLOAK_JWKS_URL=https://<tunnel>/realms/jos/protocol/openid-connect/certs

# Resend (transactional email).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=JOS Academy

# AWS S3 (course hero images, avatars).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# This API's own public URL (NOT the frontend) — the transcode-callback webhook
# URL handed to media-processor-service is built from it.
API_BASE_URL=http://localhost:3000

# media-processor-service (lesson video upload + HLS transcoding). The API key must
# match an "academy:<key>" entry in that service's MEDIA_PROCESSOR_API_KEYS, and the
# webhook secret must equal the service's MEDIA_PROCESSOR_WEBHOOK_SECRET.
MEDIA_PROCESSOR_URL=https://media-processor.josmedia.org
MEDIA_PROCESSOR_API_KEY=
MEDIA_PROCESSOR_WEBHOOK_SECRET=

# Paystack (credit top-ups).
PAYSTACK_SECRET_KEY=
# Browser redirect after checkout — must be a FRONTEND page (GET), never the API's POST-only /credits/webhook.
# The webhook itself is set in the Paystack dashboard: https://<api-domain>/credits/webhook
PAYSTACK_CALLBACK_URL=http://localhost:3000/profile/credits

# Extra browser origins allowed by CORS, comma-separated, no trailing slash
# (the Amplify URL and http://localhost:3000 are always allowed).
CORS_ORIGINS=

# Set to "false" only for a local Postgres without TLS (e.g. Docker). Neon needs TLS.
DATABASE_SSL=

# Social sign-in. Each provider's buttons appear only when BOTH its ID and
# secret are set. Register this redirect URI with the provider:
#   ${API_BASE_URL}/auth/oauth/google/callback
#   ${API_BASE_URL}/auth/oauth/linkedin/callback
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web).
# LinkedIn: linkedin.com/developers → app → Auth, with the "Sign In with LinkedIn
# using OpenID Connect" product added.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
